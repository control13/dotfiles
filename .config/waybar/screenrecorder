# Requires wf-recorder: https://github.com/ammen99/wf-recorder

SIGNAL=2
pidf="/tmp/waybar-screenrecorder"
declare -a wf_recorder_opts=()
# Specify video codec
# find available video codecs with `ffmpeg -encoders`
wf_recorder_opts+=(--codec h264_vaapi)
VIDEOEXT="mkv"
# Audio is captured by a separate ffmpeg process, see start_audio()
# find available audio codecs with `ffmpeg -codecs`
AUDIOEXT="mka"
AUDIO_CODEC="flac"
# 1 = record every microphone, each into its own track, so the recording does
# not depend on which one happens to be the default. 0 = default source only.
RECORD_ALL_MICS=1
# The internal DMIC carries a DC offset of up to -0.37 of full scale, which eats
# headroom and makes level meters and normalisation useless. Block it below the
# audible range. Applied to the microphones only, never to the system track.
MIC_HIGHPASS=20
# Low storage mode: 1 = record at reduced resolution and framerate, and encode
# audio with LOWRES_AUDIO_CODEC. Scaling runs on the GPU inside the VAAPI
# encoder, so the video side of this costs no CPU.
LOWRES=0
LOWRES_WIDTH=1280
LOWRES_FPS=15
# FLAC does not compress room noise, so every microphone track costs about
# 4 MB/min and the audio outgrows the reduced video. Opus brings that down to
# roughly 0.7 MB/min per track.
LOWRES_AUDIO_CODEC="libopus"

if [ "$LOWRES" == "1" ]; then
	# --filter replaces wf-recorder's default filter string, so format and
	# range have to be repeated here. min() avoids upscaling small regions.
	wf_recorder_opts+=(--framerate "$LOWRES_FPS")
	wf_recorder_opts+=(--filter "scale_vaapi=format=nv12:w=min(iw\,$LOWRES_WIDTH):h=-2:out_range=full")
	AUDIO_CODEC="$LOWRES_AUDIO_CODEC"
fi

# Print "name<TAB>description<TAB>mute" for every usable input source. Monitors
# are skipped, and so is any source whose active port reports "not available" —
# that is how PipeWire marks an empty jack, so an unplugged headset input drops
# out on its own and comes back the moment something is plugged in. The default
# source comes first so its track is always the one right after System.
list_mic_sources() {
	local default_src
	default_src=$(pactl get-default-source 2>/dev/null)
	pactl list sources 2>/dev/null | awk -v def="$default_src" '
		function flush(   line) {
			if (name != "" && mon == "n/a" && (port == "" || avail[port] != 0)) {
				line = name "\t" desc "\t" mute
				if (name == def) print line; else rest[++n] = line
			}
			name = ""; desc = ""; mute = ""; mon = ""; port = ""
			delete avail
		}
		/^Source #/ { flush() }
		/^\tName: / { name = $2 }
		/^\tDescription: / { sub(/^\tDescription: /, ""); desc = $0 }
		/^\tMute: / { mute = $2 }
		/^\tMonitor of Sink: / { mon = $NF }
		/^\t\t\[/ {
			p = $0
			sub(/^\t\t/, "", p)
			id = p
			sub(/:.*/, "", id)
			avail[id] = (p ~ /not available/) ? 0 : 1
		}
		/^\tActive Port: / { port = $0; sub(/^\tActive Port: /, "", port) }
		END { flush(); for (i = 1; i <= n; i++) print rest[i] }
	'
}

# Record the default sink monitor plus the microphones, each into its own
# stereo track. Sets audio_pid, or leaves it empty if no device was found, and
# audio_warning to whatever the user should know about the inputs.
start_audio() {
	local audf="$1" logf="$2"
	local sink name desc mute
	local -a args=() maps=()
	local i=0

	audio_pid=""
	audio_warning=""
	sink=$(pactl get-default-sink 2>/dev/null)
	if [ -z "$sink" ]; then
		printf "WARNING: no default sink, recording without audio\n" >>"$logf"
		audio_warning="no default sink, recording without audio"
		return
	fi
	args+=(-thread_queue_size 1024 -f pulse -i "$sink.monitor")
	maps+=(-map "$i:a" "-metadata:s:a:$i" "title=System")
	i=$((i + 1))

	while IFS=$'\t' read -r name desc mute; do
		[ -n "$name" ] || continue
		args+=(-thread_queue_size 1024 -f pulse -i "$name")
		maps+=(-map "$i:a" "-metadata:s:a:$i" "title=$desc")
		maps+=("-filter:a:$i" "highpass=f=$MIC_HIGHPASS")
		i=$((i + 1))
		if [ "$mute" == "yes" ]; then
			audio_warning="${audio_warning:+$audio_warning; }$desc is muted"
		fi
		[ "$RECORD_ALL_MICS" == "1" ] || break
	done < <(list_mic_sources)

	if [ "$i" == "1" ]; then
		audio_warning="${audio_warning:+$audio_warning; }no microphone found"
	fi
	printf "recording %d audio tracks\n" "$i" >>"$logf"
	ffmpeg -hide_banner -nostdin -y "${args[@]}" \
		"${maps[@]}" -c:a "$AUDIO_CODEC" \
		-cluster_time_limit 1000 -flush_packets 1 \
		"$audf" >>"$logf" 2>&1 &
	audio_pid=$!
}

# Mux the raw video and the audio file of one recording into its final file.
# Both are read even when they carry no trailer, which is what is left behind
# after a crash. Returns non-zero if the recording could not be assembled.
mux_recording() {
	local vidf="$1" logf="$2"
	local bf="${vidf%."$VIDEOEXT"}"
	local rawvid="$bf.video.$VIDEOEXT"
	local audf="$bf.$AUDIOEXT"

	if [ ! -s "$rawvid" ]; then
		printf "ERROR: %s is missing or empty\n" "$rawvid" >>"$logf"
		return 1
	fi
	if [ ! -s "$audf" ]; then
		printf "WARNING: no audio file, keeping video only\n" >>"$logf"
		mv "$rawvid" "$vidf"
		return 0
	fi
	# -map 1:a takes every audio track, however many were recorded; without it
	# ffmpeg would keep only one of them. Stream titles survive the copy.
	if ffmpeg -hide_banner -nostdin -y -i "$rawvid" -i "$audf" \
		-map 0:v -map 1:a -c copy \
		"$vidf" >>"$logf" 2>&1; then
		rm -f "$rawvid" "$audf"
		return 0
	fi
	printf "ERROR: muxing failed, keeping %s and %s\n" "$rawvid" "$audf" >>"$logf"
	return 1
}

# Stop both encoders and mux their output into a single file.
stop_recording() {
	local vpid="$1" apid="$2" vidf="$3" logf="$4"
	local i

	kill -INT "$vpid" 2>/dev/null
	[ -n "$apid" ] && kill -INT "$apid" 2>/dev/null

	# Wait for both encoders to write their trailers before muxing
	for ((i = 0; i < 100; i++)); do
		if ! kill -0 "$vpid" 2>/dev/null &&
			{ [ -z "$apid" ] || ! kill -0 "$apid" 2>/dev/null; }; then
			break
		fi
		sleep 0.1
	done

	mux_recording "$vidf" "$logf"
}

if [ "$1" == "status" ]; then
	if [ -s "$pidf" ]; then
		awk 'BEGIN{printf "{\"text\":\"\", \"tooltip\":\"Recording\\n"}
		NR==1{printf "Video PID: %s\\n", $0}
		NR==2{printf "Audio PID: %s\\n", ($0=="" ? "none" : $0)}
		NR==3{printf "Save to: %s\\n", $0}
		NR==4{printf "Log to: %s", $0}
		NR==5 && $0!=""{printf "\\nWARNING: %s", $0}
		END{printf "\"}\n"}' "$pidf"
	else
		printf '{"text":"", "tooltip":"Stopped"}\n'
	fi

elif [ "$1" == "toggle" ]; then
	if [ -s "$pidf" ]; then
		vpid=$(awk 'NR==1' "$pidf")
		apid=$(awk 'NR==2' "$pidf")
		vidf=$(awk 'NR==3' "$pidf")
		logf=$(awk 'NR==4' "$pidf")
		stop_recording "$vpid" "$apid" "$vidf" "$logf"
		printf "" > "$pidf"
	else
		mkdir -p "$HOME/Videos/Screencasts"
		bf="$HOME/Videos/Screencasts/$(date +'%Y%m%dT%H%M%S')"
		vidf="$bf.$VIDEOEXT"
		rawvid="$bf.video.$VIDEOEXT"
		audf="$bf.$AUDIOEXT"
		logf="$bf.log"
		if [ "$2" == "fullscreen" ]; then
			wf-recorder "${wf_recorder_opts[@]}" --file "$rawvid" 1>>"$logf" 2>&1 &
		elif [ "$2" == "region" ]; then
			sleep 1
			wf-recorder "${wf_recorder_opts[@]}" --geometry "$(slurp)" --file "$rawvid" 1>>"$logf" 2>&1 &
		else
			printf "Argument \$2='%s' not valid (fullscreen/region)" "$2"
			exit
		fi
		vpid=$!
		disown "$vpid"
		start_audio "$audf" "$logf"
		[ -n "$audio_pid" ] && disown "$audio_pid"
		[ -n "$audio_warning" ] && printf "WARNING: %s\n" "$audio_warning" >>"$logf"
		printf "%s\n%s\n%s\n%s\n%s" "$vpid" "$audio_pid" "$vidf" "$logf" "$audio_warning" > "$pidf"
	fi
	pkill -RTMIN+"$SIGNAL" waybar

elif [ "$1" == "--fix" ]; then
	# Assemble recordings whose muxing step never ran, for example because the
	# machine crashed. Run by hand, never automatically.
	if [ -s "$pidf" ]; then
		printf "ERROR: a recording is running, stop it first\n"
		exit 1
	fi
	shopt -s nullglob
	found=0
	for rawvid in "$HOME/Videos/Screencasts"/*.video."$VIDEOEXT"; do
		found=1
		bf="${rawvid%.video."$VIDEOEXT"}"
		vidf="$bf.$VIDEOEXT"
		if [ -e "$vidf" ]; then
			printf "SKIP    %s (%s already exists)\n" "$rawvid" "$vidf"
		elif mux_recording "$vidf" "$bf.log"; then
			printf "FIXED   %s\n" "$vidf"
		else
			printf "FAILED  %s (see %s.log)\n" "$rawvid" "$bf"
		fi
	done
	if [ "$found" == "0" ]; then
		printf "nothing to fix\n"
	fi

else
	printf "ERROR: Argument %s not valid (status/toggle/--fix)\n" "$1"
fi
