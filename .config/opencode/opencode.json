{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "todoist": {
      "type": "remote",
      "url": "https://ai.todoist.net/mcp",
      "enabled": true
    }
  },
  "provider": {
    "gwdg": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GWDG Academic Cloud",
